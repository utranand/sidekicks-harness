# Inherited Sidekicks runtime — git-ignore set.
# Generated by sk-inherit on first create; safe to extend by hand (never regenerated).

# Python virtual environment. Rebuild it from requirements.txt:
#   python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/

# Per-CLI skill exposure links (Rule 3). These are folder links, self-healed by the CLI on every
# invocation — committing one checks out as a plain-text stub on Windows (core.symlinks=false),
# which silently breaks skill discovery.
#
# `.agents/skills` is deliberately ABSENT: it is the CANONICAL tree, a real committed directory, not
# a link. Listing it here ignored every skill the runtime carries — a forged core committed and
# published ZERO skills while all three links still resolved into the empty directory, so a consumer
# who mounted it got no required floor at all and `framework doctor` failed `entry-unknown` for the
# criteria those skills declare. lib/core-lifecycle/_seed.mjs carries the same warning for the
# workspace-side list; this file is its twin and was missed when the tree moved.
.claude/skills
.agent/skills
.gemini/skills

# Machine-local scope state and secrets.
#
# Configuration is a folder per scope, one file per family: the committed `config/<family>.yaml`
# carries the structure with every credential key present but empty, and its git-ignored
# `config/<family>.secret.yaml` sibling carries the values. Never hand-edit either — use
# `sidekicks config get|set|where|list|doctor`. See docs/guide/configuration.md.
#
# The pre-family `config.yaml` monolith is legacy: still read one layer lower, ignored whole
# because a single credential in it made the entire file unpublishable — the exact portability
# problem the split fixes. Seed a scope with `sidekicks config set`, not by copying an example.
.sidekicks/config/*.secret.yaml
projects/*/config/*.secret.yaml

# Derived and per-machine state — rebuilt, never edited, so the whole directory is ignored.
.sidekicks/state/
.sidekicks/index.json
.sidekicks/config.yaml
.sidekicks/settings.local.json
.sidekicks/running-agents.json
.claude/settings.local.json
.env
.env.*
!.env.example

# Generated output and run state
artifacts/
output/
tmp/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
